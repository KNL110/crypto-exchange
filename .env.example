# Copy to .env (gitignored) and fill in the secrets.
#
# Loaded automatically on startup from the working directory. Variables
# already set in the real environment win over this file, and every variable
# here wins over config/config.yaml. In production, set these from your
# secrets manager instead of a file.
#
# Secrets live here, never in config.yaml. Non-secret settings belong in
# config.yaml; the commented lines below are only for one-off overrides.

CONFIG_PATH=./config/config.yaml

# --- Secrets (environment only) ---
# Database URL, includes the password. Required.
DB_PATH=postgresql://<username>:<password>@localhost:5432/<DatabaseName>
# The exchange's own operator key (hex, no 0x). Never a user's key. Required.
OPERATOR_PRIVATE_KEY=<PRIVATE_KEY>
# Makes the WAL tamper-evident: deleted or reordered records stop startup.
# Generate with: openssl rand -hex 32. Leave empty to disable.
# Turning it on for an existing unsigned WAL fails by design: start a fresh WAL.
WAL_HMAC_KEY=

# --- Optional overrides of config.yaml ---
# HOST=0.0.0.0
# PORT=8080
# GANACHE_HOST=localhost
# GANACHE_PORT=8545
# LOG_LEVEL=info
# LOG_PRETTY=false
# WAL_PATH=./data/wal.log
