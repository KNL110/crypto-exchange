# Copy to .env and adjust as needed. .env itself is gitignored and loaded
# automatically on startup (see internal/config/config.go); these are just
# the defaults config.Load() already falls back to if no variable, and no
# .env file, is present at all.

PORT=3000
LOG_LEVEL=info
LOG_PRETTY=false
WAL_PATH=./data/wal.log
# Unset by default: WAL integrity checking is off. Set this to a real secret
# (e.g. `openssl rand -hex 32`) to make the write-ahead log tamper-evident —
# see README's "Write-ahead log integrity" section before relying on this.
WAL_HMAC_KEY=
SYMBOLS=BTC-USD,ETH-USD
SHUTDOWN_TIMEOUT=10s
